#!/bin/bash
# Script principal para gestionar PH Control con Docker

set -e

# Colores
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Función de ayuda
show_help() {
    echo -e "${BLUE}🏢 PH Control - Gestión Docker${NC}"
    echo "================================"
    echo ""
    echo "Comandos principales:"
    echo "  up        - Iniciar PH Control"
    echo "  down      - Detener PH Control"
    echo "  restart   - Reiniciar servicios"
    echo "  logs      - Ver logs"
    echo "  status    - Ver estado"
    echo "  shell     - Acceder al contenedor"
    echo "  db        - Conectar a base de datos"
    echo "  backup    - Crear backup"
    echo "  clean     - Limpiar sistema"
    echo ""
    echo "Uso: ./ph-docker [comando]"
    echo ""
}

# Verificar Docker
check_docker() {
    if ! docker info > /dev/null 2>&1; then
        echo -e "${RED}❌ Docker no está ejecutándose${NC}"
        exit 1
    fi
}

# Iniciar servicios
start_services() {
    echo -e "${GREEN}🚀 Iniciando PH Control...${NC}"
    docker-compose up -d --build
    
    echo ""
    echo -e "${GREEN}✅ PH Control iniciado correctamente${NC}"
    echo -e "${BLUE}🌐 Accede a: http://localhost:5003${NC}"
    echo ""
    echo "Usuarios de prueba:"
    echo "  👤 Admin: admin@phcontrol.com / admin123"
    echo "  🏠 Residente: maria.gonzalez@example.com / demo123"
}

# Detener servicios
stop_services() {
    echo -e "${YELLOW}⏹️ Deteniendo PH Control...${NC}"
    docker-compose down
    echo -e "${GREEN}✅ Servicios detenidos${NC}"
}

# Reiniciar servicios
restart_services() {
    echo -e "${YELLOW}🔄 Reiniciando PH Control...${NC}"
    docker-compose restart
    echo -e "${GREEN}✅ Servicios reiniciados${NC}"
}

# Ver logs
show_logs() {
    echo -e "${BLUE}📋 Logs de PH Control:${NC}"
    docker-compose logs -f --tail=100
}

# Ver estado
show_status() {
    echo -e "${BLUE}📊 Estado de PH Control:${NC}"
    echo ""
    docker-compose ps
    echo ""
    echo -e "${BLUE}💾 Recursos:${NC}"
    docker stats --no-stream ph-control-web ph-control-database ph-control-redis 2>/dev/null || true
}

# Acceder al shell
access_shell() {
    echo -e "${BLUE}🐚 Accediendo al contenedor...${NC}"
    docker-compose exec ph-web bash
}

# Conectar a base de datos
connect_database() {
    echo -e "${BLUE}🗄️ Conectando a PostgreSQL...${NC}"
    docker-compose exec ph-database psql -U phcontrol -d phcontrol_db
}

# Crear backup
create_backup() {
    echo -e "${BLUE}💾 Creando backup...${NC}"
    mkdir -p backups
    BACKUP_FILE="backups/ph-backup-$(date +%Y%m%d_%H%M%S).sql"
    docker-compose exec -T ph-database pg_dump -U phcontrol phcontrol_db > "$BACKUP_FILE"
    echo -e "${GREEN}✅ Backup creado: $BACKUP_FILE${NC}"
}

# Limpiar sistema
clean_system() {
    echo -e "${YELLOW}🧹 Limpiando sistema Docker...${NC}"
    echo -e "${RED}⚠️ Esto eliminará contenedores y volúmenes${NC}"
    read -p "¿Continuar? (s/N): " confirm
    
    if [ "$confirm" = "s" ] || [ "$confirm" = "S" ]; then
        docker-compose down -v
        docker system prune -f
        echo -e "${GREEN}✅ Sistema limpio${NC}"
    else
        echo "Operación cancelada"
    fi
}

# Función principal
main() {
    check_docker
    
    case "${1:-help}" in
        "up"|"start")
            start_services
            ;;
        "down"|"stop")
            stop_services
            ;;
        "restart")
            restart_services
            ;;
        "logs")
            show_logs
            ;;
        "status")
            show_status
            ;;
        "shell")
            access_shell
            ;;
        "db")
            connect_database
            ;;
        "backup")
            create_backup
            ;;
        "clean")
            clean_system
            ;;
        "help"|*)
            show_help
            ;;
    esac
}

main "$@"